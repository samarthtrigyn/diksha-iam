{
  "realm": "diksha-demo",
  "enabled": true,
  "displayName": "DIKSHA Demo",
  "users": [
    {
      "username": "admin",
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@diksha.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin_password"
        }
      ],
      "realmRoles": ["ADMIN"],
      "clientRoles": {}
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator role"
      },
      {
        "name": "LEARNER",
        "description": "Learner role"
      },
      {
        "name": "INSTRUCTOR",
        "description": "Instructor role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "diksha-portal",
      "name": "DIKSHA Portal",
      "description": "Frontend SPA for DIKSHA IAM login flow with PKCE",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "baseUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/auth/callback",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "+"
      ],
      "attributes": {
        "oidc.max_refresh_token_reuse": "0",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/login"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "iam-admin-client",
      "name": "IAM Admin Client",
      "description": "Service account for IAM Orchestrator to manage users",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "iam-admin-client-secret",
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ]
    }
  ]
}

