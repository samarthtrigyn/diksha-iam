              "raw": "{\n  \"txnId\": \"{{txnId}}\",\n  \"password\": \"NewPass@123456\",\n  \"confirmPassword\": \"NewPass@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/iam/auth/reset-password/complete",
              "host": ["{{baseUrl}}"],
              "path": ["iam", "auth", "reset-password", "complete"]
            },
