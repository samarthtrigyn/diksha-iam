    {
      "name": "🔐 Keycloak Admin API (Debugging)",
      "description": "Keycloak administration endpoints for system debugging and troubleshooting",
      "item": [
        {
          "name": "Get Keycloak Admin Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('kcAdminToken', jsonData.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "iam-admin-client"
                },
                {
                  "key": "client_secret",
                  "value": "{{kcAdminSecret}}"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{keycloakRealm}}/protocol/openid-connect/token",
              "host": ["{{keycloakUrl}}"],
              "path": ["realms", "{{keycloakRealm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Get admin token from Keycloak for accessing admin APIs."
          },
          "response": []
        },
        {
          "name": "Get Keycloak User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kcAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{keycloakUrl}}/admin/realms/{{keycloakRealm}}/users/{{kcUserId}}",
              "host": ["{{keycloakUrl}}"],
              "path": ["admin", "realms", "{{keycloakRealm}}", "users", "{{kcUserId}}"]
            },
            "description": "Get user details from Keycloak."
          },
          "response": []
        },
        {
          "name": "List Keycloak Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kcAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{keycloakUrl}}/admin/realms/{{keycloakRealm}}/users?max=50&first=0",
              "host": ["{{keycloakUrl}}"],
              "path": ["admin", "realms", "{{keycloakRealm}}", "users"],
              "query": [
                {
                  "key": "max",
                  "value": "50"
                },
                {
                  "key": "first",
                  "value": "0"
                }
              ]
            },
            "description": "List all users in Keycloak realm."
          },
          "response": []
        },
        {
          "name": "Search Keycloak User by Email",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{kcAdminToken}}"
              }
            ],
            "url": {
              "raw": "{{keycloakUrl}}/admin/realms/{{keycloakRealm}}/users?email=testuser@diksha.local",
              "host": ["{{keycloakUrl}}"],
              "path": ["admin", "realms", "{{keycloakRealm}}", "users"],
              "query": [
                {
                  "key": "email",
                  "value": "testuser@diksha.local"
                }
              ]
            },
            "description": "Search user in Keycloak by email address."
