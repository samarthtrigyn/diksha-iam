{
  "info": {
    "name": "DIKSHA IAM - Complete API Collection",
    "description": "Comprehensive Postman collection for DIKSHA IAM system including:\n1. All login and registration flows\n2. All IAM core APIs\n3. All non-mocked OTP service APIs\n4. All Keycloak APIs for debugging",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Authentication & Login Flows",
      "description": "Complete authentication flows including direct grant login, registration, and password reset",
      "item": [
        {
          "name": "Direct Grant Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('accessToken', jsonData.tokens.accessToken);",
                  "    pm.environment.set('refreshToken', jsonData.tokens.refreshToken);",
                  "    pm.environment.set('userId', jsonData.user.userId);",
                  "    pm.environment.set('sessionId', jsonData.sessionId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"testuser@diksha.local\",\n  \"password\": \"Test@123456\",\n  \"clientId\": \"diksha-portal\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/iam/auth/login/direct-grant",
              "host": ["{{baseUrl}}"],
              "path": ["iam", "auth", "login", "direct-grant"]
            },
            "description": "Direct Grant Flow - Authenticate user with email/phone and password. Returns JWT tokens and session ID."
          },
          "response": []
        },
        {
          "name": "Registration - Init",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"newuser@diksha.local\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/iam/auth/register/init",
              "host": ["{{baseUrl}}"],
              "path": ["iam", "auth", "register", "init"]
            },
            "description": "Initialize registration flow. Returns transaction ID for OTP flow."
          },
          "response": []
        },
        {
          "name": "Registration - Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txnId\": \"{{txnId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/iam/auth/register/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["iam", "auth", "register", "send-otp"]
            },
            "description": "Send OTP to user's email. Use mock OTP code: 123456"
          },
          "response": []
        },
        {
          "name": "Registration - Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txnId\": \"{{txnId}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/iam/auth/register/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["iam", "auth", "register", "verify-otp"]
            },
            "description": "Verify OTP code sent to user. Mock OTP: 123456"
          },
          "response": []
        },
        {
          "name": "Registration - Complete",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('newUserId', jsonData.user.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txnId\": \"{{txnId}}\",\n  \"password\": \"Test@123456\",\n  \"confirmPassword\": \"Test@123456\",\n  \"termsAccepted\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/iam/auth/register/complete",
              "host": ["{{baseUrl}}"],
              "path": ["iam", "auth", "register", "complete"]
            },
            "description": "Complete registration and create user in IAM DB and Keycloak. Returns user object with nextStep."
          },
          "response": []
        },
