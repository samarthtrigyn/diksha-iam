      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "frontendRedirectUri",
      "value": "http://localhost:5173/callback"
    },
    {
      "key": "iamServiceUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "provider",
      "value": "google"
    },
    {
