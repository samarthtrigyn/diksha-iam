    {
      "name": "🔧 Keycloak Admin (Debug)",
      "description": "Raw Keycloak admin API calls for debugging token exchange issues.\n\n> Set `keycloakUrl` = `http://localhost:8080`, `realm` = `diksha-demo`",
      "item": [
        {
          "name": "Get Admin Token (client_credentials)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type",    "value": "client_credentials" },
                { "key": "client_id",     "value": "iam-admin-client" },
                { "key": "client_secret", "value": "iam-admin-client-secret" }
              ]
            },
            "url": {
              "raw": "http://localhost:8080/realms/diksha-demo/protocol/openid-connect/token",
              "host": ["http://localhost:8080"],
              "path": ["realms", "diksha-demo", "protocol", "openid-connect", "token"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = bru.getBody();",
                  "if (b.access_token) bru.setVar('kcAdminToken', b.access_token);",
                  "console.log('admin token length:', b.access_token?.length);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Direct Grant (password) – raw Keycloak",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id",  "value": "diksha-portal" },
                { "key": "username",   "value": "{{testIdentifier}}" },
                { "key": "password",   "value": "{{testPassword}}" },
                { "key": "scope",      "value": "openid" }
              ]
            },
            "url": {
              "raw": "http://localhost:8080/realms/diksha-demo/protocol/openid-connect/token",
              "host": ["http://localhost:8080"],
              "path": ["realms", "diksha-demo", "protocol", "openid-connect", "token"]
            },
            "description": "Bypass the orchestrator and call Keycloak directly. Useful to verify Keycloak has the user and their password is set correctly."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = bru.getBody();",
                  "if (b.access_token) {",
                  "  bru.setVar('accessToken',  b.access_token);",
                  "  bru.setVar('refreshToken', b.refresh_token);",
                  "  console.log('Direct grant OK, token length:', b.access_token.length);",
                  "} else {",
                  "  console.error('Direct grant failed:', b.error, b.error_description);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Token – raw Keycloak",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type",    "value": "refresh_token" },
                { "key": "client_id",     "value": "diksha-portal" },
                { "key": "refresh_token", "value": "{{refreshToken}}" }
              ]
            },
            "url": {
              "raw": "http://localhost:8080/realms/diksha-demo/protocol/openid-connect/token",
              "host": ["http://localhost:8080"],
              "path": ["realms", "diksha-demo", "protocol", "openid-connect", "token"]
            }
          }
        },
